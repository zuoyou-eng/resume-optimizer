# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 压测中间产物（原始数据 .perf/perf-result.json 保留，缓存不保留）
scripts/__pycache__/

# 运行日志（运行时产物，不入库）
*.log
backend/.backend.log

# 界面截图：默认不入库（可能含真实简历原文），仅放行实验课交付的 6 张
# （这 6 张均基于 examples/ 下的自造虚构样本生成，不含真实个人信息）
screenshots/*
!screenshots/01-upload.png
!screenshots/02-parse-result.png
!screenshots/03-diagnose-report.png
!screenshots/04-draft-workspace.png
!screenshots/05-highlight-mining.png
!screenshots/06-resume-list.png

# 本地临时验证目录
.e2e/

# 数据与上传文件（含简历原文，不入库）
backend/data/
!backend/data/.gitkeep

# Node
node_modules/
dist/

# 环境与密钥
.env
*.local

# 系统
.DS_Store
Thumbs.db
